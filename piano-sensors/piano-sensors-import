#!/bin/sh
# piano-sensors-import - stage the sensors PD inputs for hexagonrpcd.
#
# The ADSP sensors PD of the Xiaomi Pad 8 Pro reads its JSON configuration
# from the odm partition and its calibration and registry from persist.
# Both belong to the individual tablet, so nothing is shipped: they are
# copied once from the device's own partitions into the hexagonrpcd root.
#
#   odm      EROFS, read with dump.erofs (never mounted)
#   persist  ext4, mounted read-only with noload (no journal replay), so the
#            partition Android uses is never written
#
# Each part is imported only while it is missing; delete it to re-import.
set -eu

ROOT=${PIANO_SENSORS_ROOT:-/var/lib/piano-sensors}
ODM=${PIANO_SENSORS_ODM:-/dev/disk/by-partlabel/odm_a}
PERSIST=${PIANO_SENSORS_PERSIST:-/dev/disk/by-partlabel/persist}
CONFIG_DIR=/etc/sensors/config

log() { echo "piano-sensors-import: $*"; }

mkdir -p "$ROOT/sensors"

if [ ! -s "$ROOT/sensors/config/json.lst" ]; then
    tmp=$(mktemp -d "$ROOT/sensors/.config.XXXXXX")
    dump.erofs --path="$CONFIG_DIR/json.lst" --cat "$ODM" > "$tmp/json.lst"
    n=0
    for name in $(tr -d '\r' < "$tmp/json.lst"); do
        case $name in */* | .*) log "skipping odd entry $name"; continue ;; esac
        if dump.erofs --path="$CONFIG_DIR/$name" --cat "$ODM" > "$tmp/$name" 2>/dev/null; then
            n=$((n + 1))
        else
            rm -f "$tmp/$name"
            log "$name is listed but not in odm"
        fi
    done
    [ "$n" -gt 0 ] || { rm -rf "$tmp"; log "no sensors configuration in $ODM"; exit 1; }
    chmod 0755 "$tmp"
    rm -rf "$ROOT/sensors/config"
    mv "$tmp" "$ROOT/sensors/config"
    log "imported $n configuration files from $ODM"
fi

# Same layout as the stock vendor/etc/sensors/sns_reg_config, without the
# Android property hooks.
if [ ! -s "$ROOT/sensors/sns_reg.conf" ]; then
    cat > "$ROOT/sensors/sns_reg.conf" <<'CONF'
version=1
file=input=json.lst
file=output=/mnt/vendor/persist/sensors/registry/registry
CONF
fi

if [ ! -d "$ROOT/persist/sensors" ]; then
    mnt=$(mktemp -d /run/piano-sensors-persist.XXXXXX)
    tmp=$(mktemp -d "$ROOT/.persist.XXXXXX")
    mount -t ext4 -o ro,noload,nodev,nosuid,noexec "$PERSIST" "$mnt"
    status=0
    if [ -d "$mnt/sensors" ]; then
        cp -a "$mnt/sensors" "$tmp/sensors" || status=$?
    else
        # No calibration yet: the sensors PD starts from defaults.
        mkdir "$tmp/sensors"
        log "no sensors directory on persist"
    fi
    umount "$mnt"
    rmdir "$mnt"
    [ "$status" = 0 ] || { rm -rf "$tmp"; exit "$status"; }
    mkdir -p "$ROOT/persist"
    mv "$tmp/sensors" "$ROOT/persist/sensors"
    rmdir "$tmp"
    log "imported the sensors calibration and registry from $PERSIST"
fi

# The sensors PD rewrites its registry here through hexagonrpcd.
chown -R fastrpc:fastrpc "$ROOT/persist/sensors"
