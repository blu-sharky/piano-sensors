#!/bin/sh
# piano-sensors-import - stage the sensors registry for the ADSP sensors PD.
#
# The sensors PD of the Xiaomi Pad 8 Pro keeps its registry and calibration
# on the persist partition (/mnt/vendor/persist/sensors under Android), which
# belongs to the individual tablet. Nothing is shipped: on first boot the
# directory is copied from persist, mounted read-only with noload (no journal
# replay), so the partition Android uses is never written. The ADSP updates
# its registry in the copy through adsprpcd.
#
# Delete /var/lib/piano-sensors/persist/sensors to import it again.
set -eu

ROOT=${PIANO_SENSORS_ROOT:-/var/lib/piano-sensors}
PERSIST=${PIANO_SENSORS_PERSIST:-/dev/disk/by-partlabel/persist}
LINK=${PIANO_SENSORS_LINK:-/mnt/vendor/persist/sensors}

log() { echo "piano-sensors-import: $*"; }

if [ ! -d "$ROOT/persist/sensors" ]; then
    # Block devices can still be settling this early.
    i=0
    while [ ! -e "$PERSIST" ] && [ "$i" -lt 30 ]; do sleep 1; i=$((i + 1)); done
    [ -e "$PERSIST" ] || { log "$PERSIST did not appear"; exit 1; }
    mkdir -p "$ROOT"
    mnt=$(mktemp -d /run/piano-sensors-persist.XXXXXX)
    tmp=$(mktemp -d "$ROOT/.persist.XXXXXX")
    mount -t ext4 -o ro,noload,nodev,nosuid,noexec "$PERSIST" "$mnt"
    status=0
    if [ -d "$mnt/sensors" ]; then
        cp -a "$mnt/sensors" "$tmp/sensors" || status=$?
    else
        mkdir "$tmp/sensors"
        log "no sensors directory on persist"
    fi
    umount "$mnt"
    rmdir "$mnt"
    [ "$status" = 0 ] || { rm -rf "$tmp"; exit "$status"; }
    mkdir -p "$ROOT/persist"
    mv "$tmp/sensors" "$ROOT/persist/sensors"
    rmdir "$tmp"
    log "imported the sensors registry and calibration from $PERSIST"
fi

# adsprpcd opens the paths the ADSP asks for as they are.
mkdir -p "$(dirname "$LINK")"
ln -sfn "$ROOT/persist/sensors" "$LINK"
