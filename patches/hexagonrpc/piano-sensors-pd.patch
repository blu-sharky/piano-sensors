+/* piano dev patch: writable sensor registry (SEE writes its parsed registry back) */
+#define WFD_BASE 1000
+#define WFD_MAX 64
+static int wfds[WFD_MAX];
+
+static const char *persist_leaf(const char *name)
+{
+	static const char *const prefixes[] = {
+		"/mnt/vendor/persist/sensors/", "/persist/sensors/",
+	};
+	size_t i, n;
+
+	for (i = 0; i < 2; i++) {
+		n = strlen(prefixes[i]);
+		if (!strncmp(name, prefixes[i], n) && name[n] && !strstr(name + n, ".."))
+			return name + n;
+	}
+	return NULL;
+}
+
+static int persist_path(const char *name, char *path, size_t len)
+{
+	const char *dir = getenv("HEXAGONRPC_PERSIST_DIR");
+	const char *leaf = persist_leaf(name);
+
+	if (dir == NULL || leaf == NULL)
+		return -EPERM;
+	snprintf(path, len, "%s/%s", dir, leaf);
+	return 0;
+}
+
+static int wfd_open(const char *name, char mode)
+{
+	char path[512];
+	int i, fd, ret;
+
+	ret = persist_path(name, path, sizeof(path));
+	if (ret)
+		return ret;
+	fd = open(path, O_WRONLY | O_CREAT | (mode == 'a' ? O_APPEND : O_TRUNC), 0644);
+	if (fd < 0)
+		return -errno;
+	for (i = 0; i < WFD_MAX; i++) {
+		if (!wfds[i]) {
+			wfds[i] = fd + 1;
+			return WFD_BASE + i;
+		}
+	}
+	close(fd);
+	return -EMFILE;
+}
+
+/* FastRPC encodes method ids >= 31 as method 31 with the id in word 0 */
+int apps_std_ext_invoke(uint32_t sc, const struct fastrpc_io_buffer *in,
+			struct fastrpc_io_buffer **returned, uint32_t *result)
+{
+	const uint32_t *w = in[0].p;
+	char a[512], b[512];
+	uint32_t mid = w[0];
+	size_t i, n_out = REMOTE_SCALARS_OUTBUFS(sc);
+
+	*returned = NULL;
+	if (n_out) {
+		*returned = calloc(n_out, sizeof(struct fastrpc_io_buffer));
+		(*returned)[0].s = 8;
+		(*returned)[0].p = calloc(1, 8);
+		for (i = 1; i < n_out; i++) {
+			(*returned)[i].s = 0;
+			(*returned)[i].p = NULL;
+		}
+	}
+
+	switch (mid) {
+	case 33: /* frename(old, new) */
+		if (REMOTE_SCALARS_INBUFS(sc) != 3 || persist_path(in[1].p, a, sizeof(a))
+		    || persist_path(in[2].p, b, sizeof(b))) {
+			fprintf(stderr, "frename %s -> %s refused\n",
+				(const char *) in[1].p, (const char *) in[2].p);
+			*result = AEE_EBADPARM;
+			return 0;
+		}
+		*result = rename(a, b) ? AEE_EFAILED : 0;
+		return 0;
+	case 36: /* fopen_with_env_fd(env, delim, name, mode) */
+		*result = ENOENT;
+		return 0;
+	default:
+		fprintf(stderr, "Unsupported extended method %u (%08x)\n", mid, sc);
+		*result = AEE_EUNSUPPORTED;
+		return 0;
+	}
+}
+
+static int wfd_get(uint32_t fd)
+{
+	if (fd < WFD_BASE || fd >= WFD_BASE + WFD_MAX || !wfds[fd - WFD_BASE])
+		return -1;
+	return wfds[fd - WFD_BASE] - 1;
+}
+
+static uint32_t apps_std_fwrite(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	const struct {
+		uint32_t fd;
+		uint32_t buf_size;
+	} *first_in = inbufs[0].p;
+	struct {
+		uint32_t written;
+		uint32_t is_eof;
+	} *first_out = outbufs[0].p;
+	int fd = wfd_get(first_in->fd);
+	ssize_t ret;
+
+	if (fd < 0) {
+		fprintf(stderr, "fwrite on non-writable fd %u\n", first_in->fd);
+		return AEE_EBADPARM;
+	}
+	ret = write(fd, inbufs[1].p, inbufs[1].s);
+	if (ret < 0) {
+		fprintf(stderr, "Could not write file: %s\n", strerror(errno));
+		return AEE_EFAILED;
+	}
+	first_out->written = ret;
+	first_out->is_eof = 0;
+	return 0;
+}
+
